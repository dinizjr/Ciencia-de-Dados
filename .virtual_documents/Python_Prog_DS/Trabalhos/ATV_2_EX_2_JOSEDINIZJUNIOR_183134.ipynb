











import pandas as pd
import numpy as np





desired_width = 320
pd.set_option('display.width', desired_width)
np.set_printoptions(linewidth=desired_width)
pd.set_option('display.max_columns',20)
pd.set_option('display.max_rows', None)





tit = pd.read_csv('titanic_data.csv',delimiter=',',encoding='utf-8')
tit.head()











tit['Name'].count()





len(tit.columns)





tit.info()








pd.concat([tit.head(10),tit.iloc[-8:]])








verify = tit.isnull().any()
verify





where = tit.columns[verify] 
where





tit[where].isnull().sum()











tit.drop(tit.columns[[6,7,8]], axis=1, inplace=True)
tit.head()








tit.columns = ['IdPassageiro', 'Sobreviveu', 'Classe', 'Nome', 'Sexo', 'Idade', 'Tarifa', 'Cabine', 'Embarque']
tit.head()








tit.Sobreviveu.replace({0:'Não', 1:'Sim'}, inplace=True)
tit.head()








tit.Sexo.replace({'female':'Mulher', 'male':'Homem'}, inplace=True)
tit.head()











tit.Sexo.value_counts()








tit.Sobreviveu.value_counts()








tit[(tit.Sexo=='Mulher') & (tit.Sobreviveu=='Não')].Sexo.value_counts()








pd.crosstab(tit['Sobreviveu'],tit['Sexo']).apply(lambda p: p/p.sum(), axis=1)*100 #percentual











tit[(tit.Sobreviveu=='Não')].dropna(subset=['Idade']).Idade.value_counts().nlargest(1)








round(tit[(tit.Sobreviveu=='Sim') & (tit.Sexo=='Homem')].Idade.mean(),2)








tit[((tit.Sexo=='Mulher') | (tit.Idade<=15)) & (tit.Sobreviveu=='Sim')].Sexo.value_counts(normalize=True)*100








tit.groupby('Classe').size()








pd.crosstab(tit['Sobreviveu'],tit['Classe']).apply(lambda p: p/p.sum(), axis=1)*100 #percentual








qtd = pd.DataFrame({'qtd':tit.groupby(['Sexo','Classe','Sobreviveu']).size()}).reset_index()
qtd








H = tit.Sexo == 'Homem'
Age24 = tit.Idade >= 24 
Age30 = tit.Idade <= 30
C2 = tit.Classe == 2
C3 = tit.Classe == 3
S = tit.Sobreviveu == 'Sim'
N = tit.Sobreviveu == 'Não'
tit[( Age24 & Age30) & ((C3 & S) | (C2 & N))].Classe.value_counts()












hs = tit[(tit['Sobreviveu'] == 'Sim')&(tit['Sexo'] == 'Homem')]['Classe'].value_counts()
ms = tit[(tit['Sobreviveu'] == 'Sim')&(tit['Sexo'] == 'Mulher')]['Classe'].value_counts()
ts = tit[(tit['Sobreviveu'] == 'Sim')]['Sobreviveu'].count()





round(hs/ts*100,2)





round(ms/ts*100,2)




